import { Button, CheckBox, ComboBox, LineEdit, ScrollView } from "std-widgets.slint";

export struct GameRow {
    key: string,
    title: string,
    source: string,
    status: string,
    installed: bool,
    art: image,
}

export struct CatalogRow {
    key: string,
    title: string,
    subtitle: string,
    kind: int,
    selected: bool,
    required: bool,
}

component Heading inherits Text {
    color: #f3f0fc;
    font-size: 32px;
    font-weight: 700;
}

component Subtle inherits Text {
    color: #b4aec7;
    font-size: 14px;
    wrap: word-wrap;
}

component AccentButton inherits Button {
    primary: true;
}

export component ManagerWindow inherits Window {
    title: "ReShade Manager";
    preferred-width: 1136px;
    preferred-height: 748px;
    min-width: 805px;
    min-height: 595px;
    background: #11121c;
    default-font-family: "Segoe UI";

    in property <[GameRow]> games;
    in property <[CatalogRow]> catalog;
    in property <[string]> directories;
    in property <[string]> apis;
    in property <[string]> categories;
    in property <GameRow> game;
    in property <string> details;
    in property <string> summary;
    in property <string> stage;
    in property <string> cache-info;
    in property <string> package-limit: "2048";
    in property <string> artwork-limit: "128";
    in property <string> selection-info;
    in property <string> operation;
    in property <bool> installed;
    in property <bool> usable;
    in property <bool> busy;
    in property <bool> addon;
    in property <bool> classic;
    in property <bool> scan-on-launch;
    in property <bool> shared;
    in property <bool> backups;
    in property <int> page;
    in property <int> selected-api: -1;
    in property <int> filter-index;
    in property <int> selected-category;

    callback open-game(string);
    callback navigate(int);
    callback rescan();
    callback search(string);
    callback filter(int);
    callback begin(string, bool);
    callback accept-warning();
    callback set-api(int);
    callback load-catalog();
    callback set-classic(bool);
    callback catalog-search(string);
    callback category(int);
    callback catalog-action(string, int);
    callback review();
    callback execute();
    callback add-location();
    callback remove-location(int);
    callback add-executable();
    callback scan-setting(bool);
    callback shared-setting(bool);
    callback backup-setting(bool);
    callback choose-cache();
    callback cache-action(int);
    callback set-limits(string, string);
    callback artwork-action(bool);
    callback legacy();
    callback presets();
    callback diagnostics();

    HorizontalLayout {
        Rectangle {
            width: 190px;
            background: #171725;
            VerticalLayout {
                padding: 21px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 9px;
                    alignment: start;
                    Rectangle { width: 8px; height: 24px; border-radius: 4px; background: #a891f7; }
                    Text { text: "ReShade"; color: #f4efff; font-size: 24px; font-weight: 750; }
                }
                Subtle { text: "Game Manager"; }
                Rectangle { height: 22px; }
                Button { text: "Game library"; enabled: !root.busy; clicked => { root.navigate(0); } }
                Button { text: "Settings"; enabled: !root.busy; clicked => { root.navigate(1); } }
                Rectangle { vertical-stretch: 1; }
                Button { text: "Rescan games"; enabled: !root.busy; clicked => { root.rescan(); } }
            }
        }
        VerticalLayout {
            padding: 25px;
            spacing: 12px;
            if root.page == 0 : VerticalLayout {
                spacing: 14px;
                HorizontalLayout {
                    Heading { text: "Game library"; horizontal-stretch: 1; }
                    AccentButton { text: "Add executable"; enabled: !root.busy; clicked => { root.add-executable(); } }
                }
                HorizontalLayout {
                    spacing: 10px;
                    LineEdit { placeholder-text: "Search games"; edited(value) => { root.search(value); } }
                    ComboBox { width: 155px; model: ["All games", "Installed", "Not installed"]; current-index: root.filter-index; selected => { root.filter(self.current-index); } }
                }
                if root.games.length == 0 : Rectangle {
                    background: #191a2a;
                    border-radius: 11px;
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: 20px;
                        alignment: center;
                        spacing: 10px;
                        Text { text: root.busy ? "Scanning your libraries" : "No games found"; color: #f3f0fc; font-size: 22px; horizontal-alignment: center; }
                        Subtle { text: "Try a different filter, rescan, or add a game executable."; horizontal-alignment: center; }
                    }
                }
                if root.games.length > 0 : ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 8px;
                        for game in root.games : Rectangle {
                            height: 79px;
                            background: #191a2a;
                            border-radius: 10px;
                            HorizontalLayout {
                                padding: 10px;
                                spacing: 16px;
                                Rectangle {
                                    width: 88px;
                                    border-radius: 7px;
                                    background: #2b2542;
                                    clip: true;
                                    Image { source: game.art; width: parent.width; height: parent.height; image-fit: cover; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 3px;
                                    Text { text: game.title; color: #f3f0fc; font-size: 17px; font-weight: 650; overflow: elide; }
                                    Subtle { text: game.source; }
                                }
                                Text {
                                    min-width: 146px;
                                    text: (game.installed ? "✓  " : "☑  ") + game.status;
                                    color: game.installed ? #84e3b1 : #b9b2cb;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Button { text: "Manage"; enabled: !root.busy; clicked => { root.open-game(game.key); } }
                            }
                        }
                    }
                }
            }

            if root.page == 1 : VerticalLayout {
                spacing: 10px;
                Heading { text: "Settings"; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 10px;
                        Subtle { text: "Game discovery"; }
                        HorizontalLayout {
                            spacing: 8px;
                            CheckBox { text: "Scan on launch"; checked: root.scan-on-launch; enabled: !root.busy; toggled => { root.scan-setting(self.checked); } }
                            Button { text: "Add scan directory"; enabled: !root.busy; clicked => { root.add-location(); } }
                        }
                        for dir[i] in root.directories : HorizontalLayout {
                            spacing: 8px;
                            Subtle { text: dir; }
                            Button { text: "Remove"; enabled: !root.busy; clicked => { root.remove-location(i); } }
                        }
                        Subtle { text: "Installation"; }
                        CheckBox { text: "Use Classic Panel for shaders"; checked: root.classic; enabled: !root.busy; toggled => { root.set-classic(self.checked); } }
                        CheckBox { text: "Use shared shader storage"; checked: root.shared; enabled: !root.busy; toggled => { root.shared-setting(self.checked); } }
                        CheckBox { text: "Keep installation backups"; checked: root.backups; enabled: !root.busy; toggled => { root.backup-setting(self.checked); } }
                        Subtle { text: root.cache-info; }
                        HorizontalLayout {
                            spacing: 7px;
                            Button { text: "Choose package cache folder"; enabled: !root.busy; clicked => { root.choose-cache(); } }
                            Button { text: "Clear download cache"; enabled: !root.busy; clicked => { root.cache-action(0); } }
                            Button { text: "Clear artwork cache"; enabled: !root.busy; clicked => { root.cache-action(1); } }
                        }
                        HorizontalLayout {
                            spacing: 7px;
                            package := LineEdit { text: root.package-limit; placeholder-text: "Package limit MB"; }
                            artwork := LineEdit { text: root.artwork-limit; placeholder-text: "Artwork limit MB"; }
                            Button { text: "Save limits (MB)"; enabled: !root.busy; clicked => { root.set-limits(package.text, artwork.text); } }
                        }
                        Button { text: "Open diagnostics"; clicked => { root.diagnostics(); } }
                    }
                }
            }

            if root.page == 2 : VerticalLayout {
                spacing: 12px;
                Heading { text: root.game.title; overflow: elide; }
                Subtle { text: root.game.source; }
                HorizontalLayout {
                    spacing: 18px;
                    Rectangle {
                        width: 195px;
                        height: 250px;
                        background: #2b2542;
                        border-radius: 12px;
                        clip: true;
                        Image { source: root.game.art; width: parent.width; height: parent.height; image-fit: cover; }
                    }
                    VerticalLayout {
                        spacing: 8px;
                        Subtle { text: root.details; vertical-stretch: 1; }
                        HorizontalLayout {
                            spacing: 7px;
                            Button { text: "Choose artwork"; enabled: !root.busy; clicked => { root.artwork-action(false); } }
                            Button { text: "Refresh artwork"; enabled: !root.busy; clicked => { root.artwork-action(true); } }
                        }
                    }
                }
                if !root.installed : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 8px;
                        AccentButton { text: "Install ReShade"; enabled: root.usable && !root.busy; clicked => { root.begin("Install", false); } }
                        Button { text: "Install ReShade with Add-on Support"; enabled: root.usable && !root.busy; clicked => { root.begin("Install", true); } }
                    }
                    Subtle { text: "Choose the standard runtime for shader effects, or the full runtime to use optional ReShade add-ons."; }
                }
                if root.installed : VerticalLayout {
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 6px;
                        AccentButton { text: "Update"; enabled: root.usable && !root.busy; clicked => { root.begin("Update", false); } }
                        Button { text: "Repair"; enabled: root.usable && !root.busy; clicked => { root.begin("Repair", false); } }
                        Button { text: "Modify shaders"; enabled: root.usable && !root.busy; clicked => { root.begin("Modify", false); } }
                        Button { text: "Presets"; enabled: !root.busy; clicked => { root.presets(); } }
                        Button { text: "Uninstall"; enabled: root.usable && !root.busy; clicked => { root.begin("Uninstall", false); } }
                    }
                }
                Button { text: "Open legacy setup"; enabled: !root.busy; clicked => { root.legacy(); } }
                Rectangle { vertical-stretch: 1; }
            }

            if root.page == 3 : VerticalLayout {
                spacing: 14px;
                Heading { text: "Full add-on support"; }
                Subtle { text: "Some online games prohibit ReShade add-ons or modified graphics injection. Anti-cheat may flag an installation, which can lead to account restrictions or bans. Check the individual game’s policies for compatibility and permission. These policies can also affect standard ReShade."; }
                CheckBox { checked: false; text: "I understand the risks and have checked the game’s rules."; toggled => { warning-next.enabled = self.checked; } }
                warning-next := AccentButton { text: "Continue"; enabled: false; clicked => { root.accept-warning(); } }
                Rectangle { vertical-stretch: 1; }
            }

            if root.page == 4 : VerticalLayout {
                spacing: 14px;
                Heading { text: "Graphics API"; }
                Subtle { text: root.details; }
                ComboBox { model: root.apis; current-index: root.selected-api; selected => { root.set-api(self.current-index); } }
                HorizontalLayout {
                    spacing: 8px;
                    AccentButton { text: "Continue"; enabled: root.selected-api >= 0 && !root.busy; clicked => { root.load-catalog(); } }
                    Button { text: "Open legacy setup"; enabled: !root.busy; clicked => { root.legacy(); } }
                }
                Rectangle { vertical-stretch: 1; }
            }

            if root.page == 5 || root.page == 6 : VerticalLayout {
                spacing: 10px;
                Heading { text: root.page == 5 ? "Shader catalog" : "Add-on catalog"; }
                HorizontalLayout {
                    spacing: 8px;
                    LineEdit { placeholder-text: root.page == 5 ? "Search effects or packages" : "Search add-ons"; edited(value) => { root.catalog-search(value); } }
                    if root.page == 5 && !root.classic : ComboBox { width: 190px; model: root.categories; current-index: root.selected-category; selected => { root.category(self.current-index); } }
                    if root.page == 5 : Button { text: root.classic ? "Visual catalog" : "Classic Panel"; clicked => { root.set-classic(!root.classic); } }
                }
                Subtle { text: root.selection-info; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px;
                        for row in root.catalog : Rectangle {
                            min-height: 62px;
                            border-radius: 8px;
                            background: row.kind == 0 ? #25223b : #191a2a;
                            HorizontalLayout {
                                padding: 9px;
                                spacing: 8px;
                                if row.kind != 0 : CheckBox {
                                    checked: row.selected;
                                    enabled: !row.required && !root.busy;
                                    toggled => { root.catalog-action(row.key, self.checked ? 1 : 2); }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: row.title; color: #f3f0fc; font-size: 15px; font-weight: 650; overflow: elide; }
                                    Subtle { text: row.subtitle; }
                                }
                                if row.kind == 0 : Button { text: row.selected ? "Collapse" : "Expand"; clicked => { root.catalog-action(row.key, 0); } }
                                if row.kind == 0 && !row.required : Button { text: "Select all"; clicked => { root.catalog-action(row.key, 1); } }
                                if row.kind == 0 && !row.required : Button { text: "Deselect all"; clicked => { root.catalog-action(row.key, 2); } }
                            }
                        }
                    }
                }
                AccentButton { text: root.page == 5 && root.addon ? "Choose add-ons" : "Review installation"; enabled: !root.busy; clicked => { root.review(); } }
            }

            if root.page == 7 : VerticalLayout {
                spacing: 12px;
                Heading { text: root.operation + " review"; }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout { padding: 8px; Subtle { text: root.summary; } }
                }
                AccentButton { text: root.operation; enabled: !root.busy; clicked => { root.execute(); } }
            }
            if root.page == 8 : VerticalLayout {
                spacing: 14px;
                Heading { text: root.busy ? "Working on " + root.game.title : "Installation result"; }
                Subtle { text: root.stage; }
                Button { text: "Back to game details"; enabled: !root.busy; clicked => { root.open-game(root.game.key); } }
                Rectangle { vertical-stretch: 1; }
            }

            if root.page != 8 : Text {
                min-height: 24px;
                text: root.stage;
                color: #c1addd;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
    }
}
